# Supabase client configuration (optional for local development).
# When omitted, munnn01 automatically stores decks, flashcards, progress,
# and game history in browser localStorage.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Cloudflare D1 Edge API Worker (optional; defaults to production Worker URL).
# Set to "off" or "false" to disable D1 and fall back to Supabase / localStorage.
VITE_D1_API_URL=https://munnn01-d1-api.munnn01.workers.dev
